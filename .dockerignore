# Build context is the repo root (`docker buildx build ... -f
# server-go/Dockerfile .`), so this is the .dockerignore Docker reads.
# server-go/.dockerignore is NOT consulted for that build — it only
# applies if someone builds with server-go/ as the context.
#
# node_modules must be excluded: the web-build stage runs
# `pnpm install --frozen-lockfile` and then `COPY web/ ./` on top of it,
# so a local web/node_modules would overlay (and, when it was laid out
# differently, clash with — "cannot replace to directory ... with file",
# which once broke `make ship`) the one installed in the image. The
# Dockerfile copies package.json + pnpm-lock.yaml and installs deps itself.
**/node_modules

# Build outputs — regenerated inside the image, and .next in particular
# would clobber the cache mount the web-build stage relies on.
web/.next
web/out
dist
server-go/internal/web/dist

.git
.github
*.md
Dockerfile
.dockerignore

# Local-only files that must never reach a published image.
*.local.json
.env
.env.*
!.env.example
