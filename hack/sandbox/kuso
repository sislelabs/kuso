#!/usr/bin/env bash
# The kuso CLI, pointed at the current sandbox instance (KUSO_SANDBOX_NAME,
# else the last one `up` started). Runs with the instance's own HOME so it
# never reads or writes ~/.kuso (your real instances and tokens).
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
bin="${STATE_DIR}/bin/kuso"
[[ -x "$bin" ]] || die "sandbox ${KUSO_SANDBOX_NAME} has no CLI; run 'make sandbox-up'"
mkdir -p "${STATE_DIR}/home"
HOME="${STATE_DIR}/home" exec "$bin" "$@"
