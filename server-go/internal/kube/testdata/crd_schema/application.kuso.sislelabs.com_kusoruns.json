{
  "v1alpha1": {
    "properties": {
      "spec": {
        "properties": {
          "command": {
            "description": "Command to exec in the run pod. Same shape as a Pod\ncontainer's command field — argv as a list, no shell.\nUse [\"sh\",\"-c\",\"my command\"] when you need a shell.\n",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "done": {
            "default": false,
            "type": "boolean"
          },
          "env": {
            "items": {
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "valueFrom": {
                  "properties": {
                    "configMapKeyRef": {
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "name",
                        "key"
                      ],
                      "type": "object"
                    },
                    "secretKeyRef": {
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "name": {
                          "pattern": "^([a-z0-9][a-z0-9-]*-(conn|shared|secrets)|kuso-instance-shared)$",
                          "type": "string",
                          "x-kubernetes-validations": [
                            {
                              "message": "control-plane secrets (kuso-*) cannot be referenced from workload CRs",
                              "rule": "self == 'kuso-instance-shared' || !self.startsWith('kuso-')"
                            }
                          ]
                        }
                      },
                      "required": [
                        "name",
                        "key"
                      ],
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "envFromSecrets": {
            "items": {
              "pattern": "^([a-z0-9][a-z0-9-]*-(conn|shared|secrets)|kuso-instance-shared)$",
              "type": "string",
              "x-kubernetes-validations": [
                {
                  "message": "control-plane secrets (kuso-*) cannot be mounted into workload pods",
                  "rule": "self == 'kuso-instance-shared' || !self.startsWith('kuso-')"
                }
              ]
            },
            "type": "array"
          },
          "envScope": {
            "description": "The env label of the env this job runs as (copied from that env's spec.envScope by kuso-server). The chart stamps it and the job's addon-subscriber labels on the pod so env isolation treats it as that env. Empty: legacy, unlabelled.",
            "maxLength": 63,
            "type": "string"
          },
          "image": {
            "properties": {
              "digest": {
                "type": "string"
              },
              "digestRef": {
                "type": "string"
              },
              "pullPolicy": {
                "type": "string"
              },
              "pullSecret": {
                "type": "string"
              },
              "repository": {
                "type": "string"
              },
              "tag": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "placement": {
            "type": "object",
            "x-kubernetes-preserve-unknown-fields": true
          },
          "platformApiEgress": {
            "default": false,
            "description": "Mirrors the owning service's spec.platformApiEgress. When true the pod may call the kuso API.",
            "type": "boolean"
          },
          "privateEgress": {
            "default": false,
            "description": "Mirrors the owning service's spec.privateEgress. When false the pod gets the network-egress-public label and may reach the internet.",
            "type": "boolean"
          },
          "project": {
            "description": "Project the run belongs to.",
            "type": "string"
          },
          "resources": {
            "type": "object",
            "x-kubernetes-preserve-unknown-fields": true
          },
          "securityContext": {
            "description": "The owning service's opt-in extra Linux capabilities and privilege escalation (copied from its production env), for images that self-drop root at runtime. Default drops ALL caps with no escalation.",
            "properties": {
              "allowPrivilegeEscalation": {
                "type": "boolean"
              },
              "capabilities": {
                "properties": {
                  "add": {
                    "description": "Linux capabilities to ADD. Same allowlist as KusoEnvironment.spec.securityContext and kube.ValidateSecurityContext.",
                    "items": {
                      "enum": [
                        "NET_BIND_SERVICE",
                        "CHOWN",
                        "DAC_OVERRIDE",
                        "FOWNER",
                        "SETUID",
                        "SETGID",
                        "SETPCAP",
                        "KILL"
                      ],
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "type": "object"
              },
              "hostUsers": {
                "description": "false runs the pods in a Kubernetes user namespace (pod spec hostUsers: false). Unset or true = no user namespace.",
                "type": "boolean"
              }
            },
            "type": "object"
          },
          "service": {
            "description": "Service whose latest succeeded build image + env this\nrun inherits. CR name shape: \u003cproject\u003e-\u003cservice\u003e.\n",
            "type": "string"
          },
          "timeoutSeconds": {
            "default": 1800,
            "maximum": 86400,
            "minimum": 1,
            "type": "integer"
          },
          "triggeredBy": {
            "description": "user | webhook | api | system",
            "type": "string"
          },
          "triggeredByUser": {
            "type": "string"
          }
        },
        "required": [
          "project",
          "service",
          "command"
        ],
        "type": "object"
      },
      "status": {
        "type": "object",
        "x-kubernetes-preserve-unknown-fields": true
      }
    },
    "required": [
      "spec"
    ],
    "type": "object"
  }
}
